{
  "framework": "vite",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "servicio-integrado.vercel.app" }],
      "destination": "https://serviciointegrado.com.ar/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.serviciointegrado.com.ar" }],
      "destination": "https://serviciointegrado.com.ar/$1",
      "permanent": true
    }
  ]
}
